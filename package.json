{
  "name": "wordpress-nmkr-connect-smoke-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Public-safe Playwright and Phase 2 validation for the WordPress NMKR Connect plugin.",
  "scripts": {
    "test:e2e": "node scripts/nmkr-playwright.js",
    "test:e2e:report": "playwright show-report",
    "test:phase2": "bash scripts/nmkr-phase2-test-runner.sh",
    "test:phase2:existing-readonly": "NMKR_PHASE2_PROFILE=existing-readonly bash scripts/nmkr-phase2-test-runner.sh",
    "test:phase2:targeted-readonly": "NMKR_PHASE2_PROFILE=targeted-readonly bash scripts/nmkr-phase2-test-runner.sh",
    "test:php74": "bash scripts/nmkr-php74-compat-scan.sh",
    "test:public": "bash scripts/nmkr-public-checks.sh",
    "test:nmkr-api-benchmark:regression": "php scripts/nmkr-api-response-benchmark-regression.php",
    "test:e2e:settings": "node scripts/nmkr-playwright.js tests/e2e/nmkr-settings.regression.spec.ts",
    "test:e2e:dashboard": "node scripts/nmkr-playwright.js tests/e2e/nmkr-dashboard.regression.spec.ts",
    "test:e2e:projects": "node scripts/nmkr-playwright.js tests/e2e/nmkr-projects.regression.spec.ts",
    "test:e2e:shortcodes": "node scripts/nmkr-playwright.js tests/e2e/nmkr-shortcodes.regression.spec.ts",
    "test:e2e:analytics": "node scripts/nmkr-playwright.js tests/e2e/nmkr-analytics.regression.spec.ts",
    "test:e2e:ajax-security": "node scripts/nmkr-playwright.js tests/e2e/nmkr-ajax-security.regression.spec.ts",
    "test:ajax-security": "bash scripts/nmkr-ajax-security-test-runner.sh",
    "test:e2e:sync-state": "node scripts/nmkr-playwright.js tests/e2e/nmkr-sync-state.regression.spec.ts",
    "test:e2e:sync-run-authority": "node scripts/nmkr-playwright.js tests/e2e/nmkr-sync-run-authority.regression.spec.ts",
    "test:wpcli:db-state": "bash scripts/nmkr-wpcli-db-state.sh",
    "test:e2e:sync-resilience": "node scripts/nmkr-playwright.js tests/e2e/nmkr-sync-resilience.regression.spec.ts",
    "test:e2e:sync-final-state": "node scripts/nmkr-playwright.js tests/e2e/nmkr-sync-final-state.regression.spec.ts",
    "test:real-sync:preflight": "bash scripts/nmkr-real-sync-preflight.sh",
    "test:real-sync:phase16a:regression": "bash scripts/nmkr-real-sync-phase16a-regression.sh",
    "test:synthetic:provider": "php scripts/nmkr-synthetic-provider-regression.php",
    "test:synthetic:controller": "bash scripts/nmkr-synthetic-run-regression.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "dotenv": "^16.4.7"
  }
}
