WP_BASE_URL=
WP_ADMIN_USER=
WP_ADMIN_PASSWORD=
WP_ADMIN_PATH=/wp-admin
NMKR_DASHBOARD_PATH=/wp-admin/admin.php?page=nmkr-connect-dashboard
NMKR_SETTINGS_PATH=/wp-admin/options-general.php?page=nmkr-connect-settings
RUN_REAL_SYNC=false
PW_SAVE_ARTIFACTS=false
WP_PATH=
WP_CLI_BIN=wp
NMKR_PLUGIN_SLUG=nmkr-connect/nmkr-connect.php
NMKR_DEBUG_LOG_RELATIVE_PATH=wp-content/debug.log
NMKR_DEBUG_LOG_LOOKBACK_MINUTES=30
NMKR_PHASE2_ENV_FILE=
NMKR_PHASE2_LOG_DIR=
NMKR_PHASE2_SKIP_DEPLOY=false
NMKR_DEPLOY_COMMAND=
NMKR_PHASE2_INSTALL_DEPS=auto
NMKR_PHASE2_INSTALL_BROWSER=false
NMKR_PHASE2_PROFILE=
# existing-readonly requires a maintainer-supplied full SHA; it is never derived.
NMKR_PHASE2_EXPECTED_SOURCE_SHA=
# Auth state is sensitive and is removed by default. Set only true for private diagnostics.
NMKR_RETAIN_AUTH_STATE=false

# Private AJAX-security validation uses a synthetic account with exactly the
# nmkr-marketing role. It must have nmkr_view_analytics and must not have
# nmkr_view_dashboard or nmkr_manage_sync. Credentials stay private and must
# never be printed or committed. The runner never creates, changes, or deletes users.
# The npm run test:ajax-security wrapper does not source this file or
# NMKR_PHASE2_ENV_FILE; export these values first, or load an approved private
# environment into the current shell before invoking that command.
NMKR_MARKETING_USER=
NMKR_MARKETING_PASSWORD=
NMKR_MARKETING_PATH=/wp-admin/admin.php?page=nmkr-connect-projects
NMKR_AJAX_SECURITY_EXPECTED_SOURCE_SHA=
# Mandatory owner-only (0700) directory outside the checkout and web root.
NMKR_PRIVATE_RUN_ROOT=
# Mandatory canonical active plugin directory; its Git head must be exact/clean.
NMKR_DEPLOYED_PLUGIN_PATH=

# Optional Phase 2 WordPress readiness tuning.
# NMKR_PHASE2_WP_READY_TIMEOUT_SECONDS=120
# NMKR_PHASE2_WP_READY_INTERVAL_SECONDS=5
# NMKR_PHASE2_WP_READY_HTTP_TIMEOUT_SECONDS=10

# Optional WP-CLI database-state tuning.
# NMKR_DB_STATE_ALLOW_ACTIVE_SYNC=false
# NMKR_DB_STATE_STALE_SYNC_MINUTES=180

# Phase 15 guarded private real-sync preflight.
# Actual values belong in direct exported variables or an explicit absolute
# NMKR_PHASE2_ENV_FILE outside this repository and outside the WordPress root.
# When NMKR_PHASE2_ENV_FILE is used, WP_PATH must be exported directly by
# the caller; the env file must not supply WP_PATH for Phase 15.
# Phase 15 does not implicitly source repository-local .env.tests.
# NMKR_PHASE2_LOG_DIR is mandatory for test:real-sync:preflight and must point
# outside both this repository and the WordPress web root.
# NMKR_DEPLOYED_PLUGIN_PATH is optional when it can be derived safely from
# WP_PATH and NMKR_PLUGIN_SLUG.
NMKR_REAL_SYNC_CONFIRM=
NMKR_REAL_SYNC_ALLOWED_ORIGIN=
NMKR_REAL_SYNC_BACKUP_CONFIRM=
NMKR_REAL_SYNC_BACKUP_CONFIRMED_AT=
NMKR_REAL_SYNC_MAX_DURATION_SECONDS=1800
NMKR_REAL_SYNC_POLL_TIMEOUT_SECONDS=45
NMKR_REAL_SYNC_RECEIPT_TTL_SECONDS=300
NMKR_PHASE2_CURL_CA_BUNDLE=
